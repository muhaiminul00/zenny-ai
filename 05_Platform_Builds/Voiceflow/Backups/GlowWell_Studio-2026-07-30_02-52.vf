      "updatedByID": 2076840
    },
    {
      "id": "6a2d68bc4bf8dc7c0291e532",
      "name": "Membership Advisor - old",
      "createdByID": 2076840,
      "folderID": null,
      "settings": {},
      "description": "Use this when the customer asks about membership packages, pricing tiers, or long-term commitments (e.g. monthly gym membership, spa package deals). Recommends the right package based on their goals and budget.",
      "instructions": [
        {
          "text": [
            "Help the customer find the right GlowWell membership package based on their goals, budget, and commitment level.\r\n\r\n1. Ask about their goals (e.g. fitness, regular spa visits, recurring salon services) and budget preference if not already known.\r\n2. Recommend the best-fit package from the knowledge base.\r\n3. Store the chosen package in ",
            {
              "variableID": "6a2c7ce1a0c570b69f38d2c7"
            },
            " .\r\n4. If the customer mentions a corporate wellness inquiry or any opportunity worth $1,500+, hand off to Core Escalation Detection immediately — do not continue.\r\n5. Once the customer shows interest, hand off to Appointment Assistant to book a consultation/session.\r\n\r\nDone when: ",
            {
              "variableID": "6a2c7ce1a0c570b69f38d2c7"
            },
            "  is set and the customer is ready to move toward booking, OR the conversation has been escalated."
          ]
        }
      ],
      "pathToolOrder": [],
      "webSearchTool": {
        "enabled": false,
        "messages": null,
        "toolSound": null,
        "description": ""
      },
      "knowledgeBaseTool": {
        "enabled": true,
        "messages": null,
