          },
          "mcpIntegrationTools": []
        },
        "6a2c43044bf8dc7c0291d0f5": {
          "endTool": null,
          "settings": {
            "model": "gemini-3.5-flash",
            "maxTokens": 10000,
            "temperature": 0.3,
            "reasoningEffort": "low"
          },
          "cardTool": null,
          "isOperator": false,
          "buttonTool": null,
          "description": "Use this when the customer asks about products, needs a recommendation, asks about sizing or materials, or wants to know what to buy. Leads to purchase intent.",
          "skipTurnTool": null,
          "carouselTool": null,
          "webSearchTool": {
