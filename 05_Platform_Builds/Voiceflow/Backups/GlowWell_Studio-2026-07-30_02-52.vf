        },
        "6a2d69254bf8dc7c0291e545": {
          "name": "WF-VF-01 Intent Routing",
          "diagramID": "6a2d692510b4d4cdbf93e899",
          "description": "Determines what the customer wants based on their message and sets the intent variable accordingly (FAQ, service inquiry, membership inquiry, booking, escalation, or lead capture). Run this early in the conversation when intent is unclear or changes."
        },
        "6a2d69434bf8dc7c0291e553": {
          "name": "WF-VF-02 Lead Capture",
          "diagramID": "6a2d694310b4d4cdbf93e89a",
          "description": "Collects missing contact details — customer_name, customer_email, customer_phone — by asking the customer directly. Use when these fields are empty and the conversation is approaching a point where they're needed (booking, escalation, or end of conversation)."
        },
        "6a2d697d4bf8dc7c0291e578": {
          "name": "WF-VF-05 Webhook Submission",
          "diagramID": "6a2d697d10b4d4cdbf93e89f",
          "description": "Assembles the final conversation_summary and sends the complete lead data to n8n via the Create Lead tool. Use this at the natural end of every conversation, after all other relevant workflows have run."
        },
        "6a2d69574bf8dc7c0291e570": {
          "name": "WF-VF-03 Conversion Request",
          "diagramID": "6a2d695710b4d4cdbf93e89d",
          "description": "Sends the completed booking details (service_interest or package_interest, appointment_request, contact info) to n8n via the Create Conversion tool. Use this once the customer has confirmed a date and time for their appointment."
        },
        "6a2d696b4bf8dc7c0291e574": {
          "name": "WF-VF-04 Escalation Request",
          "diagramID": "6a2d696b10b4d4cdbf93e89e",
          "description": "Sends escalation details to n8n via the Create Escalation tool when escalation_flag is true. Use this immediately after Core Escalation Detection identifies a trigger, before ending the conversation."
        }
      },
      "agents": {
