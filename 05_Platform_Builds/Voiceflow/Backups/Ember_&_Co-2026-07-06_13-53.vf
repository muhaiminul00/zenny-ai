  "variableStates": [],
  "transcriptEvaluations": [
    {
      "name": "Customer satisfaction",
      "default": true,
      "description": "Measures how satisfied the customer appears based on conversation tone and content.",
      "type": "option",
      "enabled": false,
      "prompt": "Rate the customer's likely satisfaction with this AI agent conversation. Base your rating on the CUSTOMER'S experience, not the agent's technical performance. Do not infer satisfaction from politeness alone — many dissatisfied customers remain polite. You MUST select one of the following — no other values are allowed:\n\nVery Dissatisfied: The experience was clearly negative.\n\nDissatisfied: The customer's core need was not met.\n\nNeutral: The experience was unremarkable or ambiguous.\n\nSatisfied: The customer's need was effectively addressed.\n\nVery Satisfied: The experience was smooth, efficient, and frictionless.\n",
      "settings": {
        "model": "bedrock-claude-4.5-haiku",
        "maxTokens": 12000,
        "temperature": 0.3
      },
      "systemTag": "customer-satisfaction",
      "options": [
        {
          "color": "#DD4160",
          "value": "Very Dissatisfied",
          "prompt": "The experience was clearly negative. The agent failed to help, provided incorrect information, or caused frustration. The customer expressed dissatisfaction, gave up, or left worse off than when they started. Examples: Agent gave wrong information that confused the customer. Customer said 'this isn't helpful' or 'forget it.' Customer left after multiple failed attempts to get help.",
          "included": true
        },
        {
          "color": "#DD4160",
          "value": "Dissatisfied",
          "prompt": "The customer's core need was not met. The agent was mostly unhelpful, the interaction felt difficult, or the agent made notable errors. The customer may have expressed mild frustration or disengagement. Examples: Agent partially understood the request but couldn't deliver. Customer had to repeat themselves multiple times. Agent provided vague or incomplete information that didn't address the real question.",
          "included": true
        },
        {
          "color": "#515A63",
          "value": "Neutral",
          "prompt": "The experience was unremarkable or ambiguous. The customer did not express clear satisfaction or dissatisfaction. The agent may have partially addressed the need, or the resolution was adequate but the experience was not smooth. If the transcript is too short or ambiguous to assess satisfaction, classify as Neutral. Examples: Customer got a basic answer but the interaction was clunky. Agent handled the request but required unnecessary back-and-forth. Customer left without any positive or negative signals.",
          "included": true
        },
        {
          "color": "#38751F",
          "value": "Satisfied",
          "prompt": "The customer's need was effectively addressed. The conversation was clear, reasonably efficient, and the customer appeared content with the outcome. Minor imperfections may exist but did not meaningfully impact the experience. Examples: Customer asked a question and got a clear, helpful answer. Agent handled the request with minimal friction. Customer said \"thanks\" or \"got it\" after receiving a useful response.",
          "included": true
        },
        {
          "color": "#38751F",
          "value": "Very Satisfied",
          "prompt": "The experience was smooth, efficient, and frictionless. The agent resolved the customer's need quickly and clearly. The customer expressed gratitude, positive feedback, or the conversation exceeded expectations. Examples: Customer said \"perfect, thank you!\" or \"that's exactly what I needed.\" Agent resolved the issue in minimal turns with a clear, complete answer. Customer expressed surprise at how easy the experience was.",
          "included": true
        }
      ]
    },
    {
      "name": "Deflection rate",
      "default": true,
      "description": "Evaluates if the customer's issue was solved without needing human support.",
      "type": "boolean",
      "enabled": false,
      "prompt": "Was the customer's issue resolved by self-service or automation, without human agent involvement?",
      "settings": {
        "model": "bedrock-claude-4.5-haiku",
        "maxTokens": 12000,
        "temperature": 0.3
      },
      "systemTag": "deflection-rate",
      "truePrompt": "Yes — the customer was successfully deflected from human support.",
      "falsePrompt": "No — the customer required human assistance."
    },
    {
      "name": "Resolution rate",
      "default": true,
      "description": "Determines whether the customer's issue was successfully resolved.",
      "type": "option",
      "enabled": true,
      "prompt": "Evaluate whether the AI agent appropriately addressed the customer's initial request to the best of its ability. You MUST classify it as exactly one of the following — no other values are allowed:\n\nResolved: The agent appropriately addressed the customer's initial request.\n\nUnresolved: The agent failed to appropriately address the customer's initial request.\n\nAbandoned: The customer left before the agent could address their initial request. If the agent was still mid-conversation when it ended, this is Abandoned.\n\nUnrelated: The conversation had no legitimate support purpose.\n",
      "settings": {
