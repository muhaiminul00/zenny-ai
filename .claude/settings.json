{
  "permissions": {
    "allow": [
      "Bash(git commit -m *)",
      "Bash(curl -s -X POST*)",
      "Write(* .claude\\\\hooks\\\\state\\\\mode.json)",
      "Read(* .claude)",
      "Bash(cat .claude/hooks/state/mode.json)",
      "Bash(cat > .claude/hooks/state/mode.json:*)",
      "supabase - Deploy edge function (MCP)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit.ps1"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-end.ps1"
            ]
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "role-modes@role-modes": false,
    "gstack-pilot@gstack-pilot": true
  }
}
